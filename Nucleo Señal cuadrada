void mostrarMenuPrincipal(void)
{
  enviarTexto(menuPrincipal);
}

// Menu principal: se evalua el primer caracter que llegue (excepto Enter)
void procesarMenuPrincipal(char opcion)
{
  if (opcion == '1')
  {
    estado = ESTADO_SUBMENU_SPI;
    enviarTexto("\r\n\r\n Control de LEDs \r\n"
                "LED 1-3: ESP32 (SPI) | LED 4: Nucleo (senal cuadrada)\r\n"
                "Ingrese LED,tiempo_ms (ej. 1,500): ");
  }
  else if (opcion == '2')
  {
    leerSensorI2C();
    mostrarMenuPrincipal();
  }
  else
  {
    enviarTexto("\r\nComando invalido. Seleccione 1 o 2.\r\n");
    mostrarMenuPrincipal();
  }
}

// Submenu de LEDs: valida "LED,tiempo" y regresa al menu principal.
//  - LED 1-3: se envia al ESP32 por SPI (el ESP32 lo enciende ese tiempo)
//  - LED 4:   LED de la Nucleo
void procesarSubmenuSPI(char *linea)
{
  int led = 0, tiempo = 0;
  char extra;
  char msg[128];

  estado = ESTADO_MENU;  // pase lo que pase, se regresa al menu principal

  if (sscanf(linea, "%d,%d %c", &led, &tiempo, &extra) != 2)
  {
    enviarTexto("\r\nFormato invalido. Use LED,tiempo (ej. 1,500)\r\n");
  }
  else if (led < 1 || led > 4)
  {
    enviarTexto("\r\nLED invalido. Use 1, 2, 3 o 4.\r\n");
  }
  else if (tiempo < 1 || tiempo > 65535)
  {
    enviarTexto("\r\nTiempo invalido. Use de 1 a 65535 ms.\r\n");
  }
  else if (led == 4)
  {
    // LED 4 = LED de la Nucleo: señal cuadrada con el tiempo indicado en cada estado
    actualizarSenalCuadrada((uint32_t)tiempo);

    sprintf(msg, "\r\nLED 4 (Nucleo, PA10): senal cuadrada de %d ms en alto y %d ms en bajo (periodo %lu ms)\r\n",
            tiempo, tiempo, (unsigned long)tiempo * 2UL);
    enviarTexto(msg);
  }
  else
  {
    // LED 1-3 = LEDs del ESP32, por SPI
    enviarSPI((uint8_t)led, (uint16_t)tiempo);

    sprintf(msg, "\r\nEnviado por SPI -> LED %d, %d ms\r\n", led, tiempo);
    enviarTexto(msg);
  }

  mostrarMenuPrincipal();
}

// Trama de 3 bytes: [LED][tiempo alto][tiempo bajo], con CS manual en PB6
void enviarSPI(uint8_t led, uint16_t tiempoMs)
{
  uint8_t trama[3];
  trama[0] = led;
  trama[1] = (uint8_t)(tiempoMs >> 8);
  trama[2] = (uint8_t)(tiempoMs & 0xFF);

  HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, trama, 3, 100);
  HAL_GPIO_WritePin(ESP32_CS_GPIO_Port, ESP32_CS_Pin, GPIO_PIN_SET);
}

// Pide 2 bytes al ESP32 por I2C: [valor ADC alto][valor ADC bajo] (ADC de 12 bits: 0-4095)
void leerSensorI2C(void)
{
  uint8_t datos[2] = {0, 0};
  char msg[96];

  enviarTexto("\r\n-> Solicitando medicion al ESP32 por I2C...\r\n");

  HAL_StatusTypeDef st = HAL_I2C_Master_Receive(&hi2c1, I2C_ADDR_ESP32, datos, 2, 100);

  if (st == HAL_OK)
  {
    uint16_t raw = ((uint16_t)datos[0] << 8) | datos[1];

    if (raw <= 4095)
    {
      // Voltaje en milivolts con enteros (printf de float no esta habilitado por defecto)
      uint32_t mv = ((uint32_t)raw * 3300UL) / 4095UL;

      sprintf(msg, "Pot1: %u bits (0-4095) | %lu.%02lu V\r\n",
              (unsigned int)raw,
              (unsigned long)(mv / 1000),
              (unsigned long)((mv % 1000) / 10));
      enviarTexto(msg);
    }
    else
    {
      enviarTexto("Dato fuera de rango, intente de nuevo.\r\n");
    }
  }
  else
  {
    sprintf(msg, "Error I2C (codigo %lu). Revise cableado, direccion y pull-ups.\r\n",
            (unsigned long)HAL_I2C_GetError(&hi2c1));
    enviarTexto(msg);

    // Recuperar el bus por si quedo trabado tras el error
    HAL_I2C_DeInit(&hi2c1);
    MX_I2C1_Init();
  }
}

// Fija el tiempo de cada estado de la señal cuadrada y la reinicia en alto.
// Se llama cada vez que el usuario manda un comando valido nuevo.
void actualizarSenalCuadrada(uint32_t tiempoMs)
{
  __disable_irq();   // evita que la interrupcion del timer entre a medio actualizar
  contadorMs = 0;
  semiperiodoMs = tiempoMs;
  HAL_GPIO_WritePin(SENALCuadrada_GPIO_Port, SENALCuadrada_Pin, GPIO_PIN_SET);
  __enable_irq();
}

// Se ejecuta cada 1 ms (TIM6): cuando se cumple el tiempo, cambia el estado del pin
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if (htim->Instance == TIM6)
  {
    if (semiperiodoMs > 0)
    {
      contadorMs++;

      if (contadorMs >= semiperiodoMs)
      {
        contadorMs = 0;
        HAL_GPIO_TogglePin(SENALCuadrada_GPIO_Port, SENALCuadrada_Pin);
      }
    }
  }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART2)
  {
    if (!lineaLista)   // si hay un comando pendiente de procesar, se ignora lo nuevo
    {
      ultimoRxTick = HAL_GetTick();

      if (estado == ESTADO_MENU)
      {
        // Menu principal: cualquier caracter (menos Enter) se toma como opcion,
        // sin esperar Enter. Si no es 1 o 2, se avisa "Comando invalido"
        if (rxByte != '\r' && rxByte != '\n')
        {
          rxBuffer[0] = (char)rxByte;
          rxIndex = 1;
          lineaLista = 1;
        }
      }
      else
      {
        // Submenu SPI: acumula hasta Enter (o hasta que pase el timeout en el main)
        if (rxByte == '\r' || rxByte == '\n')
        {
          if (rxIndex > 0) lineaLista = 1;
        }
        else if (rxIndex < RX_BUFFER_SIZE - 1)
        {
          rxBuffer[rxIndex++] = (char)rxByte;
        }
      }
    }

    HAL_UART_Receive_IT(&huart2, &rxByte, 1);
  }
}
