/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  MX_I2C1_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  HAL_UART_Receive_IT(&huart2, &rxByte, 1);
  HAL_TIM_Base_Start_IT(&htim6);   // arranca el timer de 1 ms con interrupcion
  mostrarMenuPrincipal();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    // En el submenu: si ya llegaron caracteres y paso un rato sin mas,se mueestra el menu
    if (estado == ESTADO_SUBMENU_SPI && !lineaLista && rxIndex > 0 &&
        (HAL_GetTick() - ultimoRxTick) > TIMEOUT_LINEA_MS)
    {
      lineaLista = 1;
    }

    if (lineaLista)
    {
      rxBuffer[rxIndex] = '\0';

      if (estado == ESTADO_MENU)
      {
        procesarMenuPrincipal(rxBuffer[0]);
      }
      else
      {
        procesarSubmenuSPI(rxBuffer);
      }

      rxIndex = 0;
      lineaLista = 0;
    }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

